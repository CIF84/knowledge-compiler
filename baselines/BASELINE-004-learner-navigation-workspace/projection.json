      "evidence": [
        {
          "document_id": "scope-eb184226638e5cbb",
          "end_char": 944,
          "quote": "Variations of the double-slit experiment have been performed using electrons, atoms, and even large molecules, and the same type of interference pattern is seen.",
          "start_char": 783
        }
      ],
      "id": "explanation-ae10fa8748fdac1f",
      "participant_entity_ids": [
        "double-slit-experiment",
        "electron",
