            "model_sha256": "d0a28afecf69d8edc55783eb41b4de78c72d81ef6007ac8121a003946b06b198",
            "quote": "There are nebulae all around our galaxy, and it’s from these nebulae that stars and planets form.",
            "source_id": "nasa-solar-system-formation-2026",
            "source_sha256": "c0cb2519673b8f3ef23c0be2856e03790f53d44971cbff09d593190ab3fa155d",
