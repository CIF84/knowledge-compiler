            "model_path": "examples/evaluations/spec-052-candidate-b-v2-live-evaluation-20260915/sources/01-usgs-divergent-plate-boundaries-1996/admitted-knowledge-model.json",
            "model_sha256": "fa2494dab670a698a8f730a0501c997984467839906f5c7b702e50ad6fd61261",
            "quote": "Between 1975 and 1984, the displacements caused by rifting totalled about 7 m.",
            "source_id": "usgs-divergent-plate-boundaries-1996",
