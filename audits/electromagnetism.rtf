                    \uc0\u9474                              \u9474 \
                 PROTONS                      ELECTRONS\
                    +                             -\
                                                  \uc0\u9474 \
                                           can move through\
                                             conductors\
                                                  \uc0\u9474 \
                                                  \uc0\u9660 \
                                              CURRENT\
                                                  \uc0\u9474 \
                                                  \uc0\u9660 \
                                           MAGNETIC FIELD\
\pard\pardeftab720\sa240\partightenfactor0

\f0\fs24 \cf0 And now an important feedback structure emerges:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 charge\
  \uc0\u9474 \
  \uc0\u9660 \
electric field\
  \uc0\u9474 \
  \uc0\u9660 \
